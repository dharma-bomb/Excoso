// Firestore Security Rules for the Excoso catalog.
//
// This is NOT deployed automatically — copy/paste this whole file into:
//   Firebase Console → your project → Firestore Database → Rules tab → Publish
//
// Firebase Storage is NOT used by this project — all images are uploaded
// directly from the browser to Cloudinary (see admin/js/cloudinary.js and
// js/cloudinary-config.js); Firestore only ever stores the resulting
// https://res.cloudinary.com/... URL as a plain string. No Storage rules
// are needed or included here.
//
// What this does:
//   - Anyone (including visitors with no login) can READ categories,
//     products, banners, and settings — required for the public site to
//     render the catalog, homepage banners, and footer.
//   - Only a signed-in user (your admin account, created in
//     Authentication) can WRITE (create/edit/delete) any of the above.
//   - Quote requests: anyone can submit one (public "Get a Quote" form) —
//     shape validation below guards against garbage/oversized writes.
//     Only the signed-in admin can read, update (CRM status changes), or
//     delete them, so random visitors can't browse each other's details.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Single settings doc, always at settings/main.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quotes/{quoteId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.keys().hasAll(['name','company','email','phone','location','product','quantity','status'])
                    && request.resource.data.status == 'New';
      // CRM status updates (New/Qualified/Contacted/Quotation Sent/Won/Lost)
      // and deletes are admin-only.
      allow read, update, delete: if request.auth != null;
    }

    // Deny everything else by default (no rule needed — Firestore already
    // denies any path with no matching rule above).
  }
}
