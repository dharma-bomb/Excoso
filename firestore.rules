// Firestore Security Rules for the Excoso catalog.
// (For Firebase Storage — product/category image uploads — see the
// separate storage.rules file; it's pasted into a different tab.)
//
// This is NOT deployed automatically — copy/paste this whole file into:
//   Firebase Console → your project → Firestore Database → Rules tab → Publish
//
// What this does:
//   - Anyone (including visitors with no login) can READ categories and
//     products — required for the public site to display the catalog.
//   - Only a signed-in user (your one admin account, created in
//     Authentication) can WRITE (create/edit/delete) categories or products.
//   - Everything else is denied by default.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quote requests from the public "Get a Quote" form. Anyone can submit
    // one (it's a public contact form) — basic shape validation below
    // guards against garbage/oversized writes. Only the signed-in admin can
    // read, update (e.g. mark as contacted), or delete them, so random
    // visitors can't browse each other's contact details.
    match /quotes/{quoteId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 200
                    && request.resource.data.keys().hasAll(['name','company','email','phone','location','product','quantity','status'])
                    && request.resource.data.status == 'new';
      allow read, update, delete: if request.auth != null;
    }

    // Company contact info shown in Settings and (optionally) on the
    // public site's footer. Anyone can read it; only the signed-in admin
    // can change it.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default (no rule needed — Firestore already
    // denies any path with no matching rule above).
  }
}
